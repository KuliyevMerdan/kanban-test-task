{
  "name": "@kanban/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "start:prod": "pnpm migration:run && node dist/main",
    "typecheck": "tsc --noEmit",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:generate": "nest build && typeorm -d dist/database/data-source.js migration:generate",
    "migration:run": "typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "typeorm -d dist/database/data-source.js migration:revert",
    "db:migrate": "nest build && pnpm migration:run"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6"
  },
  "dependencies": {
    "@kanban/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  }
}
